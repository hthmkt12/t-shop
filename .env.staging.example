# ==============================================================================
# T-SHOP PRINT-ON-DEMAND - STAGING / PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Application Settings
PORT=3000
NODE_ENV=production
PAYLOAD_PUBLIC_SERVER_URL=https://staging.yourdomain.com
NEXT_PUBLIC_SERVER_URL=https://staging.yourdomain.com

# Database Connection (MongoDB)
# In Docker Compose, service name is 'mongo'
DATABASE_URI=mongodb://mongo:27017/payload-template-ecommerce

# Security Secrets (Generate unique keys for production)
PAYLOAD_SECRET=staging_payload_secret_replace_with_64_char_random_hex
PAYLOAD_PUBLIC_DRAFT_SECRET=staging_draft_secret_replace_me
NEXT_PRIVATE_DRAFT_SECRET=staging_draft_secret_replace_me
REVALIDATION_KEY=staging_revalidation_key_replace_me
NEXT_PRIVATE_REVALIDATION_KEY=staging_revalidation_key_replace_me

# Stripe Payment Gateway
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOKS_SIGNING_SECRET=whsec_your_stripe_webhook_signing_secret
PAYLOAD_PUBLIC_STRIPE_IS_TEST_KEY=true

# Cloudflare R2 / AWS S3 Storage Adapter (Artwork & Media Uploads)
# Leave S3_BUCKET empty to fall back to local disk storage (/app/media)
S3_BUCKET=t-shop-pod-media
S3_REGION=auto
S3_ENDPOINT=https://<your_account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_r2_access_key_id
S3_SECRET_ACCESS_KEY=your_r2_secret_access_key
S3_PUBLIC_DOMAIN=https://pub-<hash>.r2.dev
S3_FORCE_PATH_STYLE=false

# POD Workshop Webhook Integration
FULFILLMENT_WEBHOOK_URL=https://workshop.partner-print.com/api/webhooks/orders
FULFILLMENT_WEBHOOK_SECRET=fws_staging_secret_key_workshop_2026

# Email Notifications (SMTP)
# Leave SMTP_HOST empty for payload mock email logging
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_password_or_sendgrid_key
SMTP_FROM_NAME=T-Shop POD Support
SMTP_FROM_ADDRESS=orders@yourdomain.com
