# ==============================================================================
# T-Shop POD (Print-on-Demand) - Environment Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=3000
PAYLOAD_PUBLIC_SERVER_URL=https://your-domain.com
NEXT_PUBLIC_SERVER_URL=https://your-domain.com

# Database Connection (MongoDB Atlas or self-hosted)
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/t-shop-production?retryWrites=true&w=majority
DATABASE_URI=mongodb://127.0.0.1:27017/payload-template-ecommerce

# Payload CMS Encryption Key (Generate random 32+ characters string)
PAYLOAD_SECRET=generate_strong_random_secret_for_production_jwt

# ------------------------------------------------------------------------------
# Stripe Payments Configuration
# ------------------------------------------------------------------------------
# Secret key from Stripe Dashboard (Developers -> API keys)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
PAYLOAD_PUBLIC_STRIPE_IS_TEST_KEY=false
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

# Webhook endpoint signing secret (Stripe Dashboard -> Developers -> Webhooks)
# Webhook URL: https://your-domain.com/api/stripe/webhooks
STRIPE_WEBHOOKS_SIGNING_SECRET=whsec_your_stripe_webhook_secret

# ------------------------------------------------------------------------------
# Cloud Storage for Customer Artwork (Optional: AWS S3 / Cloudflare R2 / MinIO)
# Leave S3_BUCKET empty to store files locally in /media directory
# ------------------------------------------------------------------------------
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_FORCE_PATH_STYLE=false

# ------------------------------------------------------------------------------
# Security & Revalidation Keys
# ------------------------------------------------------------------------------
# Draft preview secret keys
PAYLOAD_PUBLIC_DRAFT_SECRET=generate_secure_draft_secret
NEXT_PRIVATE_DRAFT_SECRET=generate_secure_draft_secret

# Next.js On-Demand ISR Revalidation Key
REVALIDATION_KEY=generate_secure_revalidation_key
NEXT_PRIVATE_REVALIDATION_KEY=generate_secure_revalidation_key

# Search Engine Indexing (Set to 'true' in Production to allow indexing)
NEXT_PUBLIC_IS_LIVE=true
